# Copy to .env locally. NEVER commit real values. Configure production in Vercel.
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ACCESS_PASSWORD=
SESSION_SECRET=
# Upstash FREE Redis integration (not Pay as you go). Vercel KV aliases also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional but recommended: lock this private deployment to your own provider origin.
XTREAM_SERVER=
# UTC = Burkina Faso. Defaults: 120 min/day, 2700 min/month, 06:00–24:00.
DAILY_WATCH_MINUTES=120
MONTHLY_WATCH_MINUTES=2700
WATCH_START_HOUR_UTC=6
WATCH_END_HOUR_UTC=24
